# Choose the official REST region matching your OKX account: global, eea, or us.
OKX_REGION=global
OKX_MODE=READ_ONLY
OKX_TIMEOUT_SECONDS=5
OKX_MAX_ATTEMPTS=3

# For --demo-check only: set OKX_MODE=DEMO in your local .env and enter
# a SEPARATE Demo Trading API key with Read permission only.
# Never put real-account keys here. --check and --signal need no keys.
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_PASSPHRASE=

# Optional owner alerts from --recovery-check and --telegram-test. Keep these values in the
# local Git-ignored .env. The Telegram bot needs access to the chosen chat.
OKX_TELEGRAM_BOT_TOKEN=
OKX_TELEGRAM_CHAT_ID=

# --watchdog-once keeps a SEPARATE observation journal. On Ubuntu set this to
# /var/lib/okx-watchdog/watchdog.sqlite3; never point it at the Windows journal.
OKX_WATCHDOG_STATE_PATH=

# --health-once reads the Watchdog journal in read-only mode and keeps its own
# health.sqlite3 beside it. Default stale threshold is 15 minutes (1..1440).
OKX_HEALTH_STALE_MINUTES=15

# --demo-trade-once: Demo trading bot. Uses OKX_DEMO_TRADE_* if set, otherwise the
# OKX_DEMO_API_* key above (it then needs the Trade permission). Never a real-account key. Trading stays off unless
# OKX_TRADER_ENABLED=1. The budget is the strategy's own capital inside the Demo account.
OKX_TRADER_ENABLED=0
OKX_DEMO_TRADE_API_KEY=
OKX_DEMO_TRADE_API_SECRET=
OKX_DEMO_TRADE_PASSPHRASE=
OKX_TRADER_BUDGET_USDT=5000
OKX_TRADER_SLIPPAGE=0.0005
# On Ubuntu: /var/lib/okx-watchdog/demo_trader.sqlite3
OKX_TRADER_STATE_PATH=

# --trend-once: daily trend allocator with its own virtual book (default 100 USDT,
# mirroring the real account size). Uses the same Demo key as the trader.
OKX_TREND_ENABLED=0
OKX_TREND_BUDGET_USDT=100
# On Ubuntu: /var/lib/okx-watchdog/trend_trader.sqlite3
OKX_TREND_STATE_PATH=
