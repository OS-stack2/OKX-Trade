# Copy to .env (chmod 600). Never put a real-account key here: the code refuses LIVE mode.

# --- OKX connection ---------------------------------------------------------
# global, eea or us — must match the Demo account
OKX_REGION=global
OKX_MODE=DEMO
OKX_TIMEOUT_SECONDS=5
OKX_MAX_ATTEMPTS=3

# Demo API key. Bots need Read + Trade (no Withdraw).
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_PASSPHRASE=
# Optional separate Trade key for the bots; if empty, the key above is used.
OKX_DEMO_TRADE_API_KEY=
OKX_DEMO_TRADE_API_SECRET=
OKX_DEMO_TRADE_PASSPHRASE=

# --- Notifications and AI -----------------------------------------------------
OKX_TELEGRAM_BOT_TOKEN=
OKX_TELEGRAM_CHAT_ID=
# news radar classification and news analyst
OKX_DEEPSEEK_API_KEY=

# --- Daily trend bot (--trend-once) ---------------------------------------------
OKX_TREND_ENABLED=0
OKX_TREND_BUDGET_USDT=100
OKX_TREND_STATE_PATH=/var/lib/okx-watchdog/trend_trader.sqlite3

# --- News radar and news bot (--news-radar, --news-trade) ----------------------
OKX_NEWS_STATE_PATH=/var/lib/okx-watchdog/news_radar.sqlite3
OKX_NEWSTRADER_ENABLED=0
OKX_NEWSTRADER_BUDGET_USDT=1000
# share of the book per trade
OKX_NEWSTRADER_FRACTION=0.2
# default hold; the analyst may choose 30..240
OKX_NEWSTRADER_HOLD_MINUTES=30
# 2 or 3
OKX_NEWSTRADER_MIN_IMPACT=2
# 0 = buy immediately without the analyst
OKX_NEWSTRADER_ANALYST=1
OKX_NEWSTRADER_STATE_PATH=/var/lib/okx-watchdog/news_trader.sqlite3

# --- EMA 9/21 bot (retired 2026-10-19; keep disabled) ---------------------------
OKX_TRADER_ENABLED=0
OKX_TRADER_BUDGET_USDT=5000
OKX_TRADER_SLIPPAGE=0.0005
OKX_TRADER_STATE_PATH=/var/lib/okx-watchdog/demo_trader.sqlite3

# --- Monitoring --------------------------------------------------------------
OKX_WATCHDOG_STATE_PATH=/var/lib/okx-watchdog/watchdog.sqlite3
# BTC on the Demo account that belongs to no bot
OKX_WATCHDOG_EXTERNAL_BTC=1
OKX_HEALTH_STALE_MINUTES=15
OKX_RUNMON_STATE_PATH=/var/lib/okx-watchdog/run_monitor.sqlite3
